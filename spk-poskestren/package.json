{
  "name": "spk-poskestren-albahjah",
  "version": "1.0.0",
  "description": "Sistem Pendukung Keputusan Penentuan Prioritas Penanganan Santri Sakit - Poskestren Al-Bahjah Cabang Bogor",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:css": "npx tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch",
    "build:css:prod": "npx tailwindcss -i ./src/input.css -o ./public/css/styles.css --minify"
  },
  "keywords": ["SPK", "SAW", "pesantren", "kesehatan", "triase"],
  "author": "Poskestren Al-Bahjah Bogor",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.1"
  }
}
