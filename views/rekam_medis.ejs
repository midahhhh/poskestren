<%- include("partials/head") %>
<%- include("partials/sidebar") %>

<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="bg-white border-b border-[#DCE7E0] h-[68px] flex items-center px-6 no-print flex-shrink-0">
        <div>
            <h1 class="text-base font-extrabold text-[#0B3D2E]">Rekam Medis & Keputusan Klinis</h1>
            <p class="text-[11px] text-[#64756D]">Anamnesis, diagnosis, dan tindakan dokter</p>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-5 space-y-5">
        <%- include("partials/flash") %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
            <!-- Antrean Selector -->
            <div class="lg:col-span-4 card p-4">
                <h2 class="text-sm font-bold text-[#0B3D2E] mb-3">Pilih Pasien</h2>
                <div class="space-y-2">
                <% if (antrean.length > 0) { %>
                <% antrean.forEach(function(ant) { %>
                <% const skor = parseFloat(ant.skor_saw_akhir)||0; %>
                <% const sel = kunjId && kunjId==ant.id; %>
                <a href="/rekam-medis?kunjungan_id=<%= ant.id %>"
                   class="block p-3 rounded-xl border transition <%= sel?'border-[#16845B] bg-emerald-50':'border-[#DCE7E0] hover:border-[#16845B] hover:bg-slate-50' %>">
                    <div class="flex items-start justify-between">
                        <div>
                            <p class="font-bold text-[13px] text-[#182923]"><%= ant.nama_lengkap %></p>
                            <p class="text-[10px] text-[#64756D]">NIS: <%= ant.nis %></p>
                        </div>
                        <% if (skor>=0.80||ant.tingkat_prioritas==="P1_Gawat_Darurat") { %>
                        <span class="badge-p1 px-1.5 py-0.5 rounded-full text-[9px] font-bold">P1</span>
                        <% } else if (skor>=0.50) { %>
                        <span class="badge-p2 px-1.5 py-0.5 rounded-full text-[9px] font-bold">P2</span>
                        <% } else { %>
                        <span class="badge-p3 px-1.5 py-0.5 rounded-full text-[9px] font-bold">P3</span>
                        <% } %>
                    </div>
                    <p class="text-[10px] text-[#64756D] mt-1 line-clamp-1"><%= ant.keluhan_utama||"-" %></p>
                </a>
                <% }); %>
                <% } else { %>
                <p class="text-xs text-[#64756D] text-center py-4">Tidak ada antrean aktif saat ini.</p>
                <% } %>
                </div>
            </div>

            <!-- Form Rekam Medis -->
            <div class="lg:col-span-8">
            <% if (kunjungan) { %>
            <div class="card p-5 mb-4 border-[#16845B]/30 bg-emerald-50/20">
                <p class="text-xs font-bold text-[#0B3D2E] mb-2">Data Pasien</p>
                <div class="grid grid-cols-3 gap-4 text-xs">
                    <div><p class="text-[#64756D]">Nama</p><p class="font-bold"><%= kunjungan.nama_lengkap %></p></div>
                    <div><p class="text-[#64756D]">NIS</p><p class="font-mono font-bold"><%= kunjungan.nis %></p></div>
                    <div><p class="text-[#64756D]">Asrama</p><p class="font-bold"><%= kunjungan.kamar_asrama||"-" %></p></div>
                    <div><p class="text-[#64756D]">Suhu</p><p class="font-bold"><%= kunjungan.suhu_tubuh||"-" %> °C</p></div>
                    <div><p class="text-[#64756D]">Nadi/RR</p><p class="font-bold"><%= kunjungan.nadi||"-" %> / <%= kunjungan.rr||"-" %> x/m</p></div>
                    <div><p class="text-[#64756D]">Skala Nyeri</p><p class="font-bold"><%= kunjungan.skala_nyeri||"-" %> / 10</p></div>
                </div>
                <% if (kunjungan.riwayat_alergi) { %>
                <div class="mt-3 p-2 rounded-lg bg-red-50 border border-red-200">
                    <p class="text-[11px] font-bold text-red-700">⚠ Riwayat Alergi: <%= kunjungan.riwayat_alergi %></p>
                </div>
                <% } %>
            </div>

            <form method="POST" action="/rekam-medis/simpan" class="card p-5 space-y-4">
                <input type="hidden" name="kunjungan_id" value="<%= kunjungan.id %>">
                <div>
                    <label class="text-xs font-semibold text-[#64756D] block mb-1">Anamnesis (Keluhan Lanjutan)</label>
                    <textarea name="anamnesis" rows="3" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]" placeholder="Tambahan anamnesis dan keluhan detail..."><%= kunjungan.anamnesis||"" %></textarea>
                </div>
                <div>
                    <label class="text-xs font-semibold text-[#64756D] block mb-1">Diagnosis *</label>
                    <input type="text" name="diagnosis" value="<%= kunjungan.diagnosis||'' %>" required class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]" placeholder="Misal: ISPA, Gastritis, Demam Tifoid...">
                </div>
                <div>
                    <label class="text-xs font-semibold text-[#64756D] block mb-1">Keputusan Tindakan *</label>
                    <div class="grid grid-cols-3 gap-3">
                        <label class="flex items-center gap-2 p-3 border border-[#DCE7E0] rounded-xl cursor-pointer has-[:checked]:border-[#16845B] has-[:checked]:bg-emerald-50">
                            <input type="radio" name="keputusan_tindakan" value="rawat_jalan" checked class="accent-[#16845B]">
                            <span class="text-xs font-semibold">Rawat Jalan</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 border border-[#DCE7E0] rounded-xl cursor-pointer has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50">
                            <input type="radio" name="keputusan_tindakan" value="rawat_inap" class="accent-amber-500">
                            <span class="text-xs font-semibold">Rawat Inap</span>
                        </label>
                        <label class="flex items-center gap-2 p-3 border border-[#DCE7E0] rounded-xl cursor-pointer has-[:checked]:border-red-500 has-[:checked]:bg-red-50">
                            <input type="radio" name="keputusan_tindakan" value="rujukan" class="accent-red-500">
                            <span class="text-xs font-semibold">Rujuk RS</span>
                        </label>
                    </div>
                </div>
                <div>
                    <label class="text-xs font-semibold text-[#64756D] block mb-1">Resep Obat</label>
                    <textarea name="obat_resep" rows="3" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B] font-mono" placeholder="Contoh: Paracetamol 500mg 3x1 (sesudah makan)..."></textarea>
                </div>
                <div>
                    <label class="text-xs font-semibold text-[#64756D] block mb-1">Catatan Dokter / Instruksi</label>
                    <textarea name="catatan_dokter" rows="2" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]" placeholder="Catatan tambahan, instruksi istirahat, dll..."></textarea>
                </div>
                <div class="flex justify-end gap-3">
                    <a href="/rekam-medis" class="px-4 py-2 rounded-xl border border-[#DCE7E0] text-sm text-[#64756D]">Batal</a>
                    <button type="submit" class="btn-primary px-5 py-2 text-sm font-bold rounded-xl">Simpan Rekam Medis</button>
                </div>
            </form>
            <% } else { %>
            <div class="card p-10 text-center text-[#64756D]">
                <p class="text-3xl mb-3">📋</p>
                <p class="font-bold text-[#0B3D2E]">Pilih pasien dari daftar antrean</p>
                <p class="text-xs mt-1">Klik nama pasien di sebelah kiri untuk membuka form rekam medis.</p>
            </div>
            <% } %>
            </div>
        </div>
    </main>
</div>

<%- include("partials/footer") %>
