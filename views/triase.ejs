<%- include("partials/head") %>
<%- include("partials/sidebar") %>

<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
    <header class="bg-white border-b border-[#DCE7E0] h-[68px] flex items-center justify-between px-6 no-print flex-shrink-0">
        <div>
            <h1 class="text-base font-extrabold text-[#0B3D2E]">Triase & Kalkulasi SAW</h1>
            <p class="text-[11px] text-[#64756D]">Input pemeriksaan awal dan penentuan prioritas otomatis</p>
        </div>
        <button onclick="document.getElementById('modalTriase').showModal()" class="btn-primary px-4 py-2 text-xs font-bold rounded-xl flex items-center gap-2 shadow-sm">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i> Input Triase Baru
        </button>
    </header>

    <main class="flex-1 overflow-y-auto p-5 space-y-5">
        <%- include("partials/flash") %>

        <!-- Antrean SAW -->
        <div class="card p-5">
            <div class="flex items-center gap-2 pb-4 border-b border-[#DCE7E0] mb-4">
                <span class="w-2.5 h-2.5 rounded-full bg-[#16845B] animate-pulse"></span>
                <h2 class="text-sm font-extrabold text-[#0B3D2E]">Antrean Triase Aktif Terurut SAW</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs">
                    <thead>
                        <tr class="bg-[#F5F8F6] text-[#0B3D2E] font-bold border-y border-[#DCE7E0]">
                            <th class="py-2.5 px-3">Rank</th>
                            <th class="py-2.5 px-3">No. Antrean</th>
                            <th class="py-2.5 px-3">Santri</th>
                            <th class="py-2.5 px-3">Keluhan</th>
                            <th class="py-2.5 px-3 text-center">TTV (Suhu/Nadi/RR)</th>
                            <th class="py-2.5 px-3 text-center">Prioritas SAW</th>
                            <th class="py-2.5 px-3 text-center">Skor</th>
                            <th class="py-2.5 px-3 text-right">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#DCE7E0]">
                    <% if (antrean.length > 0) { %>
                    <% antrean.forEach(function(ant, i) { %>
                    <% const skor = parseFloat(ant.skor_saw_akhir)||0; %>
                    <% const isDarurat = ant.tingkat_prioritas==="P1_Gawat_Darurat"||skor>=0.80; %>
                    <tr class="hover:bg-slate-50/60 <%= isDarurat?'bg-red-50/20':'' %>">
                        <td class="py-3 px-3">
                            <span class="w-6 h-6 rounded-full inline-flex items-center justify-center font-bold text-[10px] <%= i===0?'bg-red-500 text-white':'bg-slate-100 text-[#0B3D2E]' %>">#<%= i+1 %></span>
                        </td>
                        <td class="py-3 px-3 font-mono text-[#64756D]"><%= ant.no_antrean %></td>
                        <td class="py-3 px-3">
                            <p class="font-semibold"><%= ant.nama_lengkap %></p>
                            <p class="text-[10px] text-[#64756D]">NIS: <%= ant.nis %></p>
                        </td>
                        <td class="py-3 px-3 max-w-[150px]"><p class="line-clamp-2"><%= ant.keluhan_utama||"-" %></p></td>
                        <td class="py-3 px-3 text-center font-mono text-[10px]">
                            <%= ant.suhu_tubuh||"—" %>°C / <%= ant.nadi||"—" %>x / <%= ant.rr||"—" %>x
                        </td>
                        <td class="py-3 px-3 text-center">
                            <% if (isDarurat) { %>
                            <span class="badge-p1 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold"><span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-ping"></span>P1 DARURAT</span>
                            <% } else if (ant.tingkat_prioritas==="P2_Mendesak"||skor>=0.50) { %>
                            <span class="badge-p2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>P2 MENDESAK</span>
                            <% } else { %>
                            <span class="badge-p3 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold"><span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>P3 BIASA</span>
                            <% } %>
                        </td>
                        <td class="py-3 px-3 text-center font-black text-sm <%= skor>=0.80?'text-red-600':skor>=0.50?'text-amber-600':'text-[#16845B]' %>"><%= skor.toFixed(3) %></td>
                        <td class="py-3 px-3 text-right">
                            <a href="/rekam-medis?kunjungan_id=<%= ant.id %>" class="btn-primary px-2.5 py-1.5 text-[10px] font-bold rounded-lg inline-block mr-1">Periksa</a>
                            <form method="POST" action="/triase/hapus/<%= ant.id %>" class="inline" onsubmit="return confirm('Hapus antrean ini?')">
                                <button class="px-2 py-1.5 bg-red-100 text-red-700 rounded-lg text-[10px] font-bold">✕</button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                    <% } else { %>
                    <tr><td colspan="8" class="py-10 text-center text-[#64756D] text-xs">
                        <p class="text-lg mb-1">✓</p>
                        <p class="font-semibold text-[#0B3D2E]">Tidak ada antrean aktif saat ini.</p>
                    </td></tr>
                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<!-- Modal Triase -->
<dialog id="modalTriase" class="rounded-2xl shadow-2xl w-full max-w-2xl p-0 backdrop:bg-black/40">
    <div class="bg-[#0B3D2E] px-6 py-4 rounded-t-2xl flex items-center justify-between">
        <h2 class="text-white font-bold text-sm flex items-center gap-2"><i data-lucide="activity" class="w-4 h-4"></i> Input Triase Baru</h2>
        <button onclick="document.getElementById('modalTriase').close()" class="text-white/60 hover:text-white">✕</button>
    </div>
    <form method="POST" action="/triase/submit" class="p-6 space-y-5">
        <!-- Emergency Override -->
        <label class="flex items-center gap-3 p-3 rounded-xl border-2 border-red-200 bg-red-50 cursor-pointer">
            <input type="checkbox" name="is_override" value="1" id="overrideCheck" class="w-4 h-4 accent-red-600">
            <div>
                <p class="font-bold text-sm text-red-800">🚨 Emergency Override — Bypass Kalkulasi SAW</p>
                <p class="text-[11px] text-red-600">Aktifkan untuk kondisi gawat darurat yang butuh penanganan INSTAN tanpa menunggu skor ranking</p>
            </div>
        </label>

        <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Pilih Santri *</label>
                <select name="santri_id" required class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
                    <option value="">-- Cari & Pilih Santri --</option>
                    <% santriList.forEach(function(s) { %>
                    <option value="<%= s.id %>"><%= s.nama_lengkap %> (NIS: <%= s.nis %>) — <%= s.kompleks_asrama||"-" %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-span-2">
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Keluhan Utama *</label>
                <textarea name="keluhan_utama" required rows="2" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]" placeholder="Deskripsikan keluhan yang dirasakan santri..."></textarea>
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Suhu Tubuh (°C)</label>
                <input type="number" name="suhu_tubuh" step="0.1" min="35" max="42" placeholder="36.5" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Tekanan Darah</label>
                <input type="text" name="tekanan_darah" placeholder="120/80" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Nadi (x/menit)</label>
                <input type="number" name="nadi" min="40" max="200" placeholder="80" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Laju Napas / RR</label>
                <input type="number" name="rr" min="10" max="40" placeholder="18" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">GCS / Kesadaran</label>
                <input type="number" name="gcs" min="3" max="15" placeholder="15" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
            <div>
                <label class="text-xs font-semibold text-[#64756D] block mb-1">Skala Nyeri (1–10)</label>
                <input type="number" name="skala_nyeri" min="1" max="10" placeholder="3" class="w-full px-3 py-2 border border-[#DCE7E0] rounded-xl text-sm focus:outline-none focus:border-[#16845B]">
            </div>
        </div>

        <!-- Nilai SAW Kriteria -->
        <div class="border border-[#DCE7E0] rounded-xl p-4 bg-[#F5F8F6]">
            <p class="text-xs font-bold text-[#0B3D2E] mb-3">Nilai Crisp Kriteria SAW (C1–C5)</p>
            <div class="grid grid-cols-5 gap-3">
            <% kriteria.forEach(function(k) { %>
            <div>
                <label class="text-[10px] font-semibold text-[#64756D] block mb-1">C<%= k.id %>: <%= k.nama_kriteria %></label>
                <select name="nilai[<%= k.id %>]" class="w-full px-2 py-1.5 border border-[#DCE7E0] rounded-lg text-xs focus:outline-none focus:border-[#16845B]">
                <% const subs = subK.filter(s=>s.kriteria_id===k.id); %>
                <% subs.forEach(function(s) { %>
                <option value="<%= s.nilai_crisp %>"><%= s.nilai_crisp %> — <%= s.label||s.deskripsi||"" %></option>
                <% }); %>
                </select>
            </div>
            <% }); %>
            </div>
        </div>

        <div class="flex justify-end gap-3">
            <button type="button" onclick="document.getElementById('modalTriase').close()" class="px-4 py-2 rounded-xl border border-[#DCE7E0] text-sm text-[#64756D]">Batal</button>
            <button type="submit" class="btn-primary px-5 py-2 text-sm font-bold rounded-xl">Simpan & Kalkulasi SAW</button>
        </div>
    </form>
</dialog>

<%- include("partials/footer") %>
